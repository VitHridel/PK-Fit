# Cloudflare Turnstile (contact form bot protection)
NEXT_PUBLIC_TURNSTILE_SITEKEY=
TURNSTILE_SECRETKEY=

# Outgoing mail: SMTP host (port 25, no TLS — owner's mail infra) and sender/recipient address
SMTP_HOST=
SMTP_SENDER=

# Social profile URLs shown in the footer and contact section
NEXT_PUBLIC_IG=
NEXT_PUBLIC_FB=

# Blog data source, read at build time AND at runtime. Only `mock` exists until the CMS
# integration lands. For local work set BLOG_SOURCE=mock in .env.local; `next build`/`next start`
# additionally need ALLOW_MOCK_BLOG=1, otherwise mock is refused (it must never reach production).
BLOG_SOURCE=
ALLOW_MOCK_BLOG=

# Mail transport. `json` = don't send, log the message instead (tests/dev). Leave empty for SMTP.
MAIL_TRANSPORT=
